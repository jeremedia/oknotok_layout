-# app/views/layout_viewer/show.html.haml
- content_for :body_class, 'viewport-page'

-# Main viewport container - full height, no scrolling
.viewport-container
  -# Left sidebar with all controls
  .controls-sidebar
    -# Header
    .sidebar-header
      %h1 OKNOTOK
      %span.layout-id Layout #{params[:id]}

    -# Layout Metadata Section
    .sidebar-section
      .section-header
        %h3 Properties
      .section-content
        .control-row
          %label{for: "layout-name-input"} Name
          %input{type: "text", id: "layout-name-input", placeholder: "Layout name"}

        .control-row
          %label{for: "plot-width-input"} Width
          %input{type: "number", id: "plot-width-input", step: 50, min: 50, placeholder: "ft"}

        .control-row
          %label{for: "plot-depth-input"} Depth
          %input{type: "number", id: "plot-depth-input", step: 50, min: 50, placeholder: "ft"}

        .control-row
          %button#btn-update-metadata.sidebar-btn Update

    -# Mode Controls Section
    .sidebar-section
      .section-header
        %h3 Edit Mode
      .section-content
        .mode-buttons
          %button#btn-mode-view.mode-btn.active
            %i.mode-icon 👁
            View
          %button#btn-mode-create.mode-btn
            %i.mode-icon ✏️
            Create
          %button#btn-mode-delete.mode-btn
            %i.mode-icon 🗑
            Delete

    -# Actions Section
    .sidebar-section
      .section-header
        %h3 Actions
      .section-content
        %button#btn-new-layout.sidebar-btn New Layout
        %button#btn-clear-layout.sidebar-btn Clear All
        %button#btn-undo.sidebar-btn
          Undo
          %span.shortcut Ctrl+Z

    -# Debug Section (at bottom)
    .sidebar-section.debug-section
      .section-header
        %h3 Debug
      .section-content
        .control-row.checkbox-row
          %input{type: "checkbox", id: "chk-debug-cursor"}
          %label{for: "chk-debug-cursor"} Show Cursor Info

  -# Main 3D viewport area
  .viewport-main
    -# Optional viewport header/toolbar
    .viewport-toolbar
      .toolbar-left
        %span.viewport-title 3D Viewport
      .toolbar-right
        %span.viewport-info
          %span#fps-counter FPS: 60
          %span.separator |
          %span#object-count Objects: 0

    -# Three.js canvas container
    #threejs-container
      -# Three.js canvas will be inserted here by JavaScript

-# Pass the Layout ID to the JavaScript
:javascript
  window.currentLayoutId = #{params[:id].to_json};

= javascript_include_tag "main", type: "module", defer: true