- if resource.errors.any?
  %div.bg-red-50.border.border-red-200.text-red-800.rounded-lg.p-4.mb-6
    %h2.font-semibold.mb-2
      = "#{pluralize(resource.errors.count, 'error')} prevented this action:"
    %ul.list-disc.list-inside.space-y-1.text-sm
      - resource.errors.full_messages.each do |message|
        %li= message
