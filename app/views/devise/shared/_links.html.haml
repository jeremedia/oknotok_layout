- if controller_name != "sessions" && devise_mapping.registerable?
  %p.mb-2
    Already have an account?
    = link_to "Log in", new_session_path(resource_name), class: "text-emerald-300 hover:text-emerald-200 font-medium"
- if devise_mapping.recoverable? && controller_name != "passwords"
  %p
    = link_to "Forgot password?", new_password_path(resource_name), class: "text-emerald-300 hover:text-emerald-200 font-medium"
